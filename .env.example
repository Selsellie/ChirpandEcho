# Defaults for the connected Vleermic ultrasonic microphone.
DEVICE=Vleermic
SAMPLE_RATE=384000
CHUNK_SECONDS=5
COOLDOWN_SECONDS=10
DETECTOR_THREADS=2
DETECTION_THRESHOLD=0.3
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=1
CAPTURE_QUEUE_CHUNKS=3
MAX_AUDIO_MB=64
MIN_FREE_MB=1024
MAX_RETRIES=3
WEB_HOST=0.0.0.0
WEB_PORT=8090
LOG_LEVEL=INFO
# Optional PNG age expiry, in days. Detection metadata is always kept.
RETENTION_DAYS=0
STORAGE_HIGH_WATER_PERCENT=85
STORAGE_LOW_WATER_PERCENT=80
AUDIO_BUFFER_TTL_SECONDS=600
